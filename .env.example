# Run `support-desk init` to generate a unique token. Never commit .env.
ADMIN_TOKEN=
BUSINESS_NAME=Your business
GREETING=Hello. I'm the automated support assistant. How can I help?
HOST=127.0.0.1
PORT=8000
PUBLIC_BASE_URL=http://localhost:8000
# Exact website origins allowed to embed the widget; comma separated.
ALLOWED_ORIGINS=
DATA_DIR=data
KNOWLEDGE_DIR=knowledge
OWNER_EMAIL=
FOLLOWUP_HOURS=24

# Local Ollama. Pull this model separately; choose a larger model if hardware permits.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
LLM_TIMEOUT_SECONDS=35

# The built-in worker sorts new Markdown, polls configured email, and flags overdue tickets.
WORKER_ENABLED=true
WORKER_INTERVAL_SECONDS=30
RATE_LIMIT_PER_MINUTE=30

# Optional local browser voice. Install .[voice], download models, start Kokoro separately.
STT_ENABLED=false
WHISPER_MODEL=small.en
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
TTS_URL=
TTS_VOICE=af_heart
VOICE_MAX_SECONDS=45
VOICE_TIMEOUT_SECONDS=60

# Optional telephone adapter. This MVP uses Twilio CLOUD speech, LOCAL support logic.
PHONE_ENABLED=false
TWILIO_AUTH_TOKEN=
PHONE_TURN_TIMEOUT_SECONDS=8

# Optional inbox: use a dedicated support mailbox and an app password if required.
IMAP_HOST=
IMAP_PORT=993
IMAP_USERNAME=
IMAP_PASSWORD=
IMAP_MAILBOX=INBOX
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURITY=ssl
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# false: all mail stays in the local outbox. true: enable explicit console Send.
EMAIL_DELIVERY_ENABLED=false
# true: allow worker delivery of new email answers and owner notifications.
# Owner-written replies still require explicit Send in the outbox.
EMAIL_AUTO_SEND=false

# Read-only connector configuration for future identity-verified integration.
# Public chat/voice/email NEVER treat an email address or order number as proof of identity.
ORDERS_FILE=
ORDERS_API_URL=
ORDERS_API_TOKEN=
